---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import PostPreview from "../components/post/PostPreview.astro";
import Separator from "../components/Separator.astro";
import PageHeader from "@components/PageHeader.astro";

const isProd = import.meta.env.PROD;
const blogCollection = await getCollection("blog", ({ data }) =>
  isProd ? !data.draft : true,
);
---

<BaseLayout title="Home">
  <div>
    <PageHeader
      title="About Me"
      description="Computer Science Researcher and Open-Source Developer with 5 years of
      experience building software, passionate about computer graphics,
      high-performance computing, GPU/GPGPU programming, and heterogeneous
      execution models. My work blends deep interest in compilers, virtual
      machines, and programming language design with practical experience
      building scalable systems and developer tooling. I'm also engaged in
      machine learning workflows and constantly exploring ways to improve
      developer experience through better automation, performance insights, and
      tooling."
    />

    <Separator label="Latest Posts" />

    <div class="latest-posts">
      {blogCollection.map((post) => <PostPreview {...post} />)}
    </div>

    <a href="/blog" class="view-all">View all posts &rarr;</a>
  </div>
</BaseLayout>

<style>
  .latest-posts {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .view-all {
    display: inline-block;
    margin-top: 2rem;
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .view-all:hover {
    text-decoration: underline;
  }
</style>
