---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import PostPreview from "../components/PostPreview.astro";

const isProd = import.meta.env.PROD;
const blogCollection = await getCollection("blog", ({ data }) =>
  isProd ? !data.draft : true,
);
---

<BaseLayout
  title="Juliano Lorenzato - Home"
  showHero={true}
  separatorLabel="Latest Posts"
>
  <div class="latest-posts">
    {blogCollection.map((post) => <PostPreview {...post} />)}
  </div>

  <a href="/blog" class="view-all">View all posts &rarr;</a>
</BaseLayout>

<style>
  .latest-posts {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .view-all {
    display: inline-block;
    margin-top: 2rem;
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .view-all:hover {
    text-decoration: underline;
  }
</style>
