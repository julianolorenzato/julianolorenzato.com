---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import avatar from "../assets/avatar.png";
import { getCollection } from "astro:content";
import PostPreview from "../components/PostPreview.astro";
import Separator from "../components/Separator.astro";

const isProd = import.meta.env.PROD;
const blogCollection = await getCollection("blog", ({ data }) =>
  isProd ? !data.draft : true,
);
---

<BaseLayout title="Juliano Lorenzato - Home">
  <div class="hero">
    <Image class="avatar" alt="avatar" src={avatar} />

    <div class="info">
      <h1>Juliano Lorenzato</h1>

      <label>
        Graphics Engineer • Scientific Researcher • M.Sc. Student in Computer
        Science
      </label>
    </div>
  </div>

  <!-- <p>
    Computer Science Researcher and Open-Source Developer with 5 years of
    experience building software, passionate about computer graphics,
    high-performance computing, GPU/GPGPU programming, and heterogeneous
    execution models. My work blends deep interest in compilers, virtual
    machines, and programming language design with practical experience building
    scalable systems and developer tooling. I’m also engaged in machine learning
    workflows and constantly exploring ways to improve developer experience
    through better automation, performance insights, and tooling.
  </p> -->

  <Separator label="Latest Posts" />

  <div class="latest-posts">
    {blogCollection.map((post) => <PostPreview {...post} />)}
  </div>
</BaseLayout>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: 2rem;

    .avatar {
      object-fit: cover;
      width: 10rem;
      height: 10rem;
      border: 1px solid var(--color-text);
      /* border-radius: 50%; */
      filter: grayscale(50%);
    }

    .info {
      label {
        font-style: italic;
        color: var(--color-text-muted);
        font-weight: thin;
      }
    }
  }
  .latest-posts {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
