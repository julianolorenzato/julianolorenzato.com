---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About Me" showHero={false}>
  <section class="resume">
    <!-- <div class="resume-header">
      <h2>Resume</h2>
      <a href="/Juliano_Lorenzato-CV.pdf" download>Download PDF</a>
    </div> -->
    <object
      data="/Juliano_Lorenzato-CV.pdf"
      type="application/pdf"
      class="resume-viewer"
    >
      <p>
        Your browser doesn't support embedded PDFs. <a
          href="/Juliano_Lorenzato-CV.pdf">Download the resume</a
        > instead.
      </p>
    </object>
  </section>
</BaseLayout>

<style>
  .resume {
    margin-top: 2rem;
  }

  .resume-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1rem;

    h2 {
      margin: 0;
    }

    a {
      color: var(--color-primary);
      font-size: 0.9rem;
      text-decoration: none;

      &:hover {
        text-decoration: underline;
      }
    }
  }

  .resume-viewer {
    width: 100%;
    height: 85vh;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
</style>
