---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostPreview from "../../components/post/PostPreview.astro";
import { getCollection } from "astro:content";

const isProd = import.meta.env.PROD;
const posts = (
  await getCollection("blog", ({ data }) => (isProd ? !data.draft : true))
).sort((a, b) => b.data.createdAt.getTime() - a.data.createdAt.getTime());

const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();

const monthFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
});

const monthKey = (date: Date) =>
  `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}`;

const months = [
  ...new Map(
    posts
      .map((post) => post.data.createdAt)
      .sort((a, b) => b.getTime() - a.getTime())
      .map((date) => [monthKey(date), date] as const),
  ).entries(),
].map(([key, date]) => ({ key, label: monthFormatter.format(date) }));
---

<BaseLayout title="Blog">
  <div class="blog-page">
    <div class="page-header">
      <h1>Blog</h1>
      <p>
        Notes on graphics programming, GPUs, compilers, and everything in
        between.
      </p>
    </div>

    <div class="container">
      {
        posts.length > 0 ? (
          <div class="posts-list" id="posts-list">
            {posts.map((post) => (
              <div
                class="post-entry"
                data-tags={post.data.tags.join(",")}
                data-month={monthKey(post.data.createdAt)}
              >
                <PostPreview {...post} />
              </div>
            ))}
          </div>
        ) : (
          <p class="empty-state">No posts yet — check back soon.</p>
        )
      }

      <p class="empty-state" id="empty-state" hidden>
        No posts match the selected filters.
      </p>

      <aside class="sidebar">
        {
          tags.length > 0 && (
            <div class="filter-group">
              <h2>Tags</h2>
              <ul>
                <li>
                  <button class="filter-btn active" data-filter="tag" data-value="all">
                    All <span class="count">{posts.length}</span>
                  </button>
                </li>
                {tags.map((tag) => (
                  <li>
                    <button class="filter-btn" data-filter="tag" data-value={tag}>
                      #{tag}
                      <span class="count">
                        {posts.filter((post) => post.data.tags.includes(tag)).length}
                      </span>
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        {
          months.length > 0 && (
            <div class="filter-group">
              <h2>Archive</h2>
              <ul>
                <li>
                  <button class="filter-btn active" data-filter="month" data-value="all">
                    All <span class="count">{posts.length}</span>
                  </button>
                </li>
                {months.map(({ key, label }) => (
                  <li>
                    <button class="filter-btn" data-filter="month" data-value={key}>
                      {label}
                      <span class="count">
                        {posts.filter((post) => monthKey(post.data.createdAt) === key).length}
                      </span>
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  const entries = document.querySelectorAll<HTMLElement>(".post-entry");
  const emptyState = document.getElementById("empty-state");
  const tagButtons = document.querySelectorAll<HTMLButtonElement>(
    '.filter-btn[data-filter="tag"]',
  );
  const monthButtons = document.querySelectorAll<HTMLButtonElement>(
    '.filter-btn[data-filter="month"]',
  );

  let activeTag = "all";
  let activeMonth = "all";

  const applyFilters = () => {
    let visibleCount = 0;

    entries.forEach((entry) => {
      const entryTags = entry.dataset.tags?.split(",") ?? [];
      const entryMonth = entry.dataset.month ?? "";

      const matchesTag = activeTag === "all" || entryTags.includes(activeTag);
      const matchesMonth = activeMonth === "all" || entryMonth === activeMonth;
      const show = matchesTag && matchesMonth;

      entry.hidden = !show;
      if (show) visibleCount++;
    });

    if (emptyState) emptyState.hidden = visibleCount > 0;
  };

  tagButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      tagButtons.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      activeTag = btn.dataset.value ?? "all";
      applyFilters();
    });
  });

  monthButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      monthButtons.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      activeMonth = btn.dataset.value ?? "all";
      applyFilters();
    });
  });
</script>

<style>
  .page-header {
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
    margin-bottom: 2rem;
  }

  .page-header h1 {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .page-header p {
    color: var(--color-text-muted);
    font-size: 1.05rem;
  }

  .container {
    display: grid;
    gap: 3rem;
    grid-template-columns: 1fr 240px;
    grid-template-areas: "content sidebar";
    align-items: start;
  }

  .posts-list {
    grid-area: content;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    min-width: 0;
  }

  .post-entry {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .post-entry:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .empty-state {
    grid-area: content;
    color: var(--color-text-muted);
    text-align: center;
    padding: 3rem 0;
    font-style: italic;
  }

  .sidebar {
    grid-area: sidebar;
    position: sticky;
    top: 6rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .filter-group h2 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .filter-group ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .filter-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    width: 100%;
    background: none;
    border: none;
    color: var(--color-text-muted);
    padding: 0.35rem 0.5rem;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    text-align: left;
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .filter-btn:hover {
    background-color: var(--color-surface-elevated);
    color: var(--color-text);
  }

  .filter-btn.active {
    background-color: var(--color-primary);
    color: var(--color-surface);
  }

  .filter-btn .count {
    font-size: 0.75rem;
    opacity: 0.75;
  }

  @media (max-width: 800px) {
    .container {
      grid-template-columns: 1fr;
      grid-template-areas:
        "sidebar"
        "content";
    }

    .sidebar {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 2rem;
    }
  }
</style>
