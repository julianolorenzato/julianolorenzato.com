---
import type { GetStaticPathsOptions, GetStaticPathsResult } from "astro";
import { type CollectionEntry, render, getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostNavigation from "../../components/post/PostNavigation.astro";
import PostHeader from "../../components/post/PostHeader.astro";
import { Code } from "astro:components";

export async function getStaticPaths(
  _: GetStaticPathsOptions,
): Promise<GetStaticPathsResult> {
  const isProd = import.meta.env.PROD;
  const posts = await getCollection("blog", ({ data }) =>
    isProd ? !data.draft : true,
  );

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { ...post },
  }));
}

const post = Astro.props as CollectionEntry<"blog">;

const { Content, headings } = await render(post);
---

<BaseLayout title={post.data.title} sidebar={false}>
  <div class="container">
    <PostHeader {...post} />
    <div class="content-container">
      <Content />
    </div>
    <PostNavigation headings={headings} />
  </div>
</BaseLayout>

<style>
  .container {
    display: grid;
    gap: 2rem;

    grid-template-columns: 1fr 200px;

    grid-template-areas:
      "header navigation"
      "content navigation";
  }

  .content-container {
    grid-area: content;

    * {
      margin: 1rem 0;
    }

    li {
      margin: 0;
    }

    ul,
    ol {
      margin-left: 4rem;
    }

    pre {
      padding: 1.5rem;
      font-size: 0.9rem;
      border-radius: var(--radius-sm);
    }
  }
</style>
