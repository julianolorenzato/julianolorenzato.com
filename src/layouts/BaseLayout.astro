---
import { Font, Image } from "astro:assets";
import Header from "../components/Header.astro";
import "../styles/global.css";
import avatar from "../assets/avatar.png";
import Separator from "../components/Separator.astro";

interface Props {
  title: string;
  showHero: boolean;
  separatorLabel?: string;
}

const { title, showHero, separatorLabel } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <Font cssVariable="--font-roboto" preload />

    <link rel="shortcut icon" href="favicon.png" type="image/x-icon" />

    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main class="main-content">
      {
        showHero && (
          <div class="hero">
            <Image class="avatar" alt="avatar" src={avatar} />

            <div class="info">
              <h1>Juliano Lorenzato</h1>

              <label>
                Graphics Engineer • Scientific Researcher • M.Sc. Student in
                Computer Science • Polymath, Autodidact & Lifelong Learner
              </label>
            </div>
          </div>

            <Separator label={separatorLabel} />
        )
      }

      <slot />
    </main>
  </body>
</html>

<style is:global>
  body {
    font-family: var(--font-roboto);
  }
</style>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: 2rem;

    .avatar {
      object-fit: cover;
      width: 10rem;
      height: 10rem;
      border: 1px solid var(--color-text);
      /* border-radius: 50%; */
      filter: grayscale(50%);
    }

    .info {
      label {
        font-style: italic;
        color: var(--color-text-muted);
        font-weight: thin;
      }
    }
  }
  .main-content {
    padding: 0rem 12rem 2rem 12rem;
    margin-top: 2rem;
  }
</style>
