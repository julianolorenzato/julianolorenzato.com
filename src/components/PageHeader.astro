---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<div class="page-header">
  <h1>{title}</h1>
  <p>{description}</p>
</div>

<style>
  .page-header {
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
    margin-bottom: 2rem;
  }

  .page-header h1 {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .page-header p {
    color: var(--color-text-muted);
    font-size: 1.05rem;
  }
</style>
