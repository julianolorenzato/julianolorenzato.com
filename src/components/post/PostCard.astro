---
import type { CollectionEntry } from "astro:content";

interface Props extends CollectionEntry<"blog"> {}

const {
  data: { title, createdAt, author, href, tags = [], image },
} = Astro.props;
---

<article class:list={["blog-card-horizontal", { "has-image": image }]}>
  {
    image && (
      <div class="card-image">
        <img src={image.src} alt={image.alt} loading="lazy" />
      </div>
    )
  }
  <div class="card-content">
    <header class="card-meta">
      <time datetime={createdAt.toString()}>{createdAt}</time>
      <span class="separator">|</span>
      <span class="author">By {author}</span>
    </header>

    <h3 class="card-title">
      <a href={href}>{title}</a>
    </h3>

    <p class="card-description">
      <!-- {description} -->
       aaaa
    </p>

    <footer class="card-footer">
      {
        tags.length > 0 && (
          <ul class="card-tags">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
      <a href={href} class="read-more">
        Read More <span>&nearr;</span>
      </a>
    </footer>
  </div>
</article>

<style>
  .blog-card-horizontal {
    display: flex;
    flex-direction: column;
    background-color: var(--main-color);
    /* border-radius: 12px; */
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    overflow: hidden;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
    color: #333;
    text-decoration: none;
  }

  .blog-card-horizontal:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  /* Image Section */
  .card-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .blog-card-horizontal:hover .card-image img {
    transform: scale(1.05);
  }

  /* Content Section */
  .card-content {
    flex: 1;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }

  /* Meta (Date | Author) */
  .card-meta {
    font-size: 0.85rem;
    color: #737373;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .separator {
    color: #e5e5e5;
  }

  /* Title */
  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 0.75rem 0;
    color: #171717;
  }

  .card-title a {
    text-decoration: none;
    color: inherit;
  }

  /* Description */
  .card-description {
    font-size: 0.95rem;
    line-height: 1.5;
    color: #525252;
    margin: 0 0 1.5rem 0;
    flex-grow: 1; /* Allows footer to align to bottom */

    /* Optional: Limit description to 3 lines */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Footer (Tags & Link) */
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: auto; /* Pushes to bottom */
  }

  /* Tags */
  .card-tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .card-tags li {
    background-color: #f3f4f6;
    color: #4b5563;
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
  }

  /* Read More Link */
  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: #2563eb; /* Example blue brand color */
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .read-more:hover {
    color: #1d4ed8;
    text-decoration: underline;
  }

  .read-more span {
    font-size: 1.1em;
    line-height: 1;
    transition: transform 0.2s ease;
  }

  .read-more:hover span {
    transform: translate(2px, -2px);
  }

  /* --- Desktop Layout (Horizontal) --- */
  @media (min-width: 768px) {
    .blog-card-horizontal.has-image {
      flex-direction: row;
      align-items: stretch; /* Ensures both sides are equal height */
    }

    .blog-card-horizontal.has-image .card-image {
      width: 40%; /* Adjust width ratio as needed */
      height: auto; /* Reset fixed height */
      flex-shrink: 0;
    }

    .blog-card-horizontal.has-image .card-content {
      width: 60%;
      padding: 2rem; /* More padding on larger screens */
    }

    /* Adjust title size for desktop */
    .card-title {
      font-size: 1.5rem;
    }
  }
</style>
