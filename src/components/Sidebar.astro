---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import avatar from "../assets/avatar.png";
---

<aside class:list={["hero", "sidebar"]}>
  <Image class="avatar" alt="avatar" src={avatar} />

  <div class="info">
    <h1>Juliano Lorenzato</h1>

    <ul>
      <li>Graphics Software Engineer</li>
      <li>Scientific Researcher</li>
      <li>M.Sc. Student in Computer Science</li>
      <!-- <li>Polymath, Autodidact & Lifelong Learner</li> -->
    </ul>
  </div>

  <div class="social-chips">
    <div class="chip">
      <Icon name="map-pin" size={18} />
      Brazil
    </div>
    <a class="chip" href="mailto:julianolorenzato@gmail.com">
      <Icon name="mail" size={18} />
      Email
    </a>
    <a class="chip" target="_blank" href="https://github.com/julianolorenzato">
      <Icon name="github" size={18} />
      GitHub
    </a>
    <a
      class="chip"
      target="_blank"
      href="https://www.linkedin.com/in/julianolorenzato/"
    >
      <Icon name="linkedin" size={18} />
      LinkedIn
    </a>
  </div>
</aside>

<style>
  .sidebar {
    padding-top: var(--padding-from-header);
    width: var(--sidebar-width);
    position: sticky;
    top: var(--header-height);
    max-height: calc(100vh - var(--header-height));
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    gap: 2rem;

    .avatar {
      object-fit: cover;
      width: 10rem;
      height: 10rem;
      border: 1px solid var(--color-text);
      /* border-radius: 50%; */
      filter: grayscale(50%);
    }

    .info {
      h1 {
        font-size: x-large;
      }

      ul {
        padding-left: 1rem;
        list-style: none;
        margin: 0;
        font-style: italic;
        color: var(--color-text-muted);
      }

      label {
        font-style: italic;
        color: var(--color-text-muted);
        font-weight: thin;
      }
    }

    .social-chips {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      align-self: stretch;
      gap: 0.6rem;
    }
  }

  .chip {
    display: flex;
    align-items: center;
    gap: 0.6rem;

    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-muted);

    transition: color var(--transition-fast);

    &:hover {
      color: var(--color-text);
    }
  }
</style>
