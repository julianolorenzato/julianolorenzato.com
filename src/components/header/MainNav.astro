---
interface NavLink {
  text: string;
  href: string;
}

interface Props {
  navLinks: NavLink[];
  isActive: (href: string) => boolean;
}

const { navLinks, isActive } = Astro.props;
---

<nav class="main-nav">
  <ul>
    {
      navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.text}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<div class="divider"></div>

<style>
  .main-nav ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 1.5rem;
  }

  .main-nav a {
    position: relative;
    text-decoration: none;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.2s ease;

    &:hover {
      color: var(--color-text);
    }

    &[aria-current="page"] {
      color: var(--color-text);

      &::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -0.4rem;
        height: 2px;
        background-color: var(--color-text);
      }
    }
  }
  .divider {
    width: 1px;
    height: 24px;
    background-color: var(--color-text-muted);
    margin: 0 0.5rem;
  }

  @media (max-width: 600px) {
    .main-nav, .divider {
      display: none;
    }
  }
</style>
