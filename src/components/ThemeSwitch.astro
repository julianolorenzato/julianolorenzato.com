<button id="theme-switch" class="theme-toggle" aria-label="Toggle Theme">
  <svg
    viewBox="0 0 24 24"
    width="20"
    height="20"
    stroke="currentColor"
    stroke-width="2"
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <!-- Sun -->
    <g class="sun">
      <circle cx="12" cy="12" r="5"></circle>
      <line x1="12" y1="1" x2="12" y2="3"></line>
      <line x1="12" y1="21" x2="12" y2="23"></line>
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
      <line x1="1" y1="12" x2="3" y2="12"></line>
      <line x1="21" y1="12" x2="23" y2="12"></line>
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
    </g>

    <!-- Moon -->
    <g class="moon">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 
               7 7 0 0 0 21 12.79z"
      ></path>
    </g>
  </svg>
</button>

<script>
  const themeSwitch = document.getElementById("theme-switch");
  const html = document.documentElement;

  const savedTheme = localStorage.getItem("theme");
  if (savedTheme) {
    html.dataset.theme = savedTheme;
  }

  themeSwitch?.addEventListener("click", (_e) => {
    const currentTheme = html.dataset.theme === "dark" ? "light" : "dark";
    html.dataset.theme = currentTheme;
    localStorage.setItem("theme", currentTheme);
  });
</script>

<style>
  /* --- Icons --- */
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    transition: color 0.2s ease;

    &:hover {
      color: var(--color-text);
    }
  }

  /* Hide moon by default */
  .moon {
    opacity: 0;
    transform: scale(0.5) rotate(-90deg);
    transform-origin: center;
    transition: all 0.3s ease;
  }

  /* Hide sun in dark mode */
  .sun {
    transition: all 0.3s ease;
  }

  /* When dark theme */
  html[data-theme="dark"] .sun {
    opacity: 0;
    transform: scale(0.5) rotate(90deg);
  }

  html[data-theme="dark"] .moon {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }
</style>
